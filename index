      <div class="card-face card-back">
        <div class="card-back-tag">אודות התוכן</div>
        <h4 class="card-back-title">${c.backTitle}</h4>
        <div class="card-back-grade">${c.grades} · קורס דיגיטלי מלא</div>
        <div class="card-back-body">${c.backBody}</div>
        <div class="card-back-cta">
          <button class="card-back-btn" data-course="${c.id}">
            ${c.cta}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg>
          </button>
          <button class="flip-back" aria-label="חזרה לכרטיס" title="חזרה">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
          </button>
        </div>
      </div>
    </div>`;
  grid.appendChild(card);
});

/* CLICK-TO-FLIP (not hover) */
document.querySelectorAll('.card').forEach(card => {
  card.addEventListener('click', e => {
    if (e.target.closest('.card-back-btn') || e.target.closest('.flip-back')) return;
    card.classList.toggle('is-flipped');
  });
  card.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      card.classList.toggle('is-flipped');
    }
  });
});
document.querySelectorAll('.flip-back').forEach(btn => {
  btn.addEventListener('click', e => {
    e.stopPropagation();
    btn.closest('.card').classList.remove('is-flipped');
  });
});

/* MODAL */
const backdrop = document.getElementById('modal-backdrop');
const modalBody = document.getElementById('modal-body');
const modalTitle = document.getElementById('modal-title');
const modalOpen = document.getElementById('modal-open');
const modalClose = document.getElementById('modal-close');

function openModal(courseId){
  const c = COURSES.find(x => x.id === courseId);
  if (!c) return;
  modalTitle.textContent = c.title;
  modalBody.innerHTML = '';

  // PRIORITY: If course has rich content (in RICH map), show it.
  // If it ALSO has an external link, show a prominent button at the bottom.
  if (c.contentKey && RICH[c.contentKey]) {
    let html = RICH[c.contentKey];
    if (c.iframeUrl) {
      html += `
        <div class="external-link-block">
          <div class="external-link-text">
            <strong>אתר הקורס</strong>
            <p>למידע נוסף, צפייה בכרטיסיות שיעור ודוגמיות מהקורס:</p>
          </div>
          <a class="external-link-btn" href="${c.iframeUrl}" target="_blank" rel="noopener">
            פתיחת אתר הקורס
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        </div>`;
    }
    modalBody.innerHTML = html;
    modalOpen.style.display = c.iframeUrl ? 'inline-flex' : 'none';
    if (c.iframeUrl) modalOpen.href = c.iframeUrl;
  }
  // Otherwise — iframe-only fallback (for courses without rich text yet)
  else if (c.iframeUrl) {
    const wrap = document.createElement('div');
    wrap.style.position = 'absolute';
    wrap.style.inset = '0';
    const iframe = document.createElement('iframe');
    iframe.src = c.iframeUrl;
    iframe.title = c.title;
    iframe.setAttribute('loading','lazy');
    const fallback = document.createElement('div');
    fallback.className = 'modal-fallback';
    fallback.innerHTML = `
      <h4>פתיחת האתר בחלון פנימי לא תמיד אפשרית</h4>
      <p>חלק מהאתרים חוסמים הצגה בתוך מסגרת. לחצו על הכפתור כדי לפתוח בכרטיסייה חדשה.</p>
      <a class="btn btn-primary" href="${c.iframeUrl}" target="_blank" rel="noopener" style="padding:14px 24px">פתיחה בכרטיסייה חדשה</a>
    `;
    wrap.appendChild(iframe);
    wrap.appendChild(fallback);
    modalBody.appendChild(wrap);
    setTimeout(()=>fallback.classList.add('show'), 1200);
    modalOpen.style.display = 'inline-flex';
    modalOpen.href = c.iframeUrl;
  } else {
    modalBody.innerHTML = `
      <div class="rich-content">
        <h3>${c.title}</h3>
        <div>${c.backBody}</div>
        <h4 style="margin-top:24px">לתיאום הדגמה ופרטים</h4>
        <p>כתבו לרונית בוואטסאפ <strong>050-527-4030</strong> או מלאו את הטופס באתר — אשמח לתת מידע מפורט ולהתאים את הקורס לבית הספר שלכן.</p>
      </div>`;
    modalOpen.style.display = 'none';
  }
  backdrop.classList.add('is-open');
  document.body.style.overflow = 'hidden';
}
function closeModal(){
  backdrop.classList.remove('is-open');
  document.body.style.overflow = '';
  setTimeout(()=>{ modalBody.innerHTML = ''; }, 260);
}
document.addEventListener('click', e=>{
  const btn = e.target.closest('.card-back-btn');
  if (btn) { e.stopPropagation(); openModal(btn.dataset.course); }
});
modalClose.addEventListener('click', closeModal);
backdrop.addEventListener('click', e=>{ if (e.target === backdrop) closeModal(); });
document.addEventListener('keydown', e=>{ if (e.key === 'Escape') closeModal(); });

/* ============================================================
   CONTACT FORM — collects details and posts to Google Sheets
   via Google Apps Script web app.
   
   ⚠️ HOW TO SET UP:
   1. Create a Google Sheet with header row:
      תאריך | שם פרטי | שם משפחה | טלפון | אימייל | בית ספר |
      תפקיד | קורסים | התנסות | חזרה | הערות
   2. Open Extensions → Apps Script and paste the doPost code 
      from the user-facing instructions.
   3. Deploy as Web App ("Execute as: me", "Who has access: Anyone").
   4. Copy the web-app URL and paste it below in GSHEETS_URL.
   ============================================================ */
const GSHEETS_URL = 'https://script.google.com/macros/s/AKfycbzFEDw1YCp3saktiBLrQICzc3eNE1wi9OPY3W8KbKb4zBbqrneC-qQukasi2YzRgqWg4Q/exec';

const emailToast = document.getElementById('emailToast');
let toastTimer = null;
function showToast(text){
  if (text) emailToast.querySelector('span').textContent = text;
  emailToast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>emailToast.classList.remove('show'), 3200);
}

const formBackdrop = document.getElementById('formBackdrop');
const formDialogClose = document.getElementById('formDialogClose');
const contactForm = document.getElementById('contactForm');
const formSuccess = document.getElementById('formSuccess');
const formSubmit = document.getElementById('formSubmit');
const formError = document.getElementById('formError');
const formErrorText = document.getElementById('formErrorText');

// Populate course checkboxes (all 12 courses)
const checkboxGrid = document.getElementById('coursesCheckboxGrid');
COURSES.forEach(c => {
  const label = document.createElement('label');
  label.className = 'checkbox-item';
  label.innerHTML = `<input type="checkbox" name="courses" value="${c.title}"><span>${c.title}</span>`;
  checkboxGrid.appendChild(label);
});

// Visual feedback for checked items + radio pills
checkboxGrid.addEventListener('change', e => {
  if (e.target.matches('input[type=checkbox]')) {
    e.target.closest('.checkbox-item').classList.toggle('is-checked', e.target.checked);
  }
});
document.querySelectorAll('.radio-pill input').forEach(radio => {
  radio.addEventListener('change', () => {
    document.querySelectorAll(`.radio-pill input[name="${radio.name}"]`).forEach(r => {
      r.closest('.radio-pill').classList.toggle('is-selected', r.checked);
    });
  });
});

function openContactForm(){
  // Reset state
  contactForm.style.display = '';
  formSuccess.style.display = 'none';
  formError.classList.remove('show');
  contactForm.reset();
  document.querySelectorAll('.checkbox-item.is-checked').forEach(el => el.classList.remove('is-checked'));
  document.querySelectorAll('.radio-pill.is-selected').forEach(el => el.classList.remove('is-selected'));
  setSubmitting(false);
  formBackdrop.classList.add('is-open');
  document.body.style.overflow = 'hidden';
}
function closeContactForm(){
  formBackdrop.classList.remove('is-open');
  document.body.style.overflow = '';
}

function setSubmitting(loading){
  formSubmit.disabled = loading;
  if (loading) {
    formSubmit.innerHTML = '<span class="spinner"></span><span>שולח...</span>';
  } else {
    formSubmit.innerHTML = '<span class="submit-label">שליחת הפנייה</span><svg class="submit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>';
  }
}

function showFormError(msg){
  formErrorText.textContent = msg;
  formError.classList.add('show');
}

// Intercept all .mail-link clicks → open contact form
document.querySelectorAll('.mail-link').forEach(el => {
  el.addEventListener('click', e => {
    e.preventDefault();
    openContactForm();
  });
});

formDialogClose.addEventListener('click', closeContactForm);
formBackdrop.addEventListener('click', e => { if (e.target === formBackdrop) closeContactForm(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && formBackdrop.classList.contains('is-open')) closeContactForm(); });

// Form submit
contactForm.addEventListener('submit', async e => {
  e.preventDefault();
  formError.classList.remove('show');

  // HTML5 validity check
  if (!contactForm.checkValidity()) {
    contactForm.reportValidity();
    return;
  }

  // Collect data
  const fd = new FormData(contactForm);
  const courses = fd.getAll('courses');
  const data = {
    firstName: fd.get('firstName') || '',
    lastName:  fd.get('lastName')  || '',
    phone:     fd.get('phone')     || '',
    email:     fd.get('email')     || '',
    school:    fd.get('school')    || '',
    role:      fd.get('role')      || '',
    courses:   courses,
    trial:     fd.get('trial')     || '',
    callback:  fd.get('callback')  || '',
    notes:     fd.get('notes')     || '',
    submittedAt: new Date().toISOString(),
  };

  setSubmitting(true);

  // If no URL configured yet, simulate success (so the page is testable
  // before Google Sheets is hooked up)
  if (!GSHEETS_URL || GSHEETS_URL.startsWith('__PASTE')) {
    console.warn('[contact form] GSHEETS_URL not configured. Form data:', data);
    setTimeout(()=>{
      setSubmitting(false);
      contactForm.style.display = 'none';
      formSuccess.style.display = 'block';
    }, 700);
    return;
  }

  try {
    // Google Apps Script doesn't support CORS preflight; use no-cors + text/plain
    await fetch(GSHEETS_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(data),
    });
    // With no-cors we can't read the response, but the request goes through.
    // Treat fetch completion as success.
    contactForm.style.display = 'none';
    formSuccess.style.display = 'block';
  } catch (err) {
    console.error('Form submit error:', err);
    setSubmitting(false);
    showFormError('משהו השתבש. אנא נסו שוב בעוד רגע, או צרו קשר בוואטסאפ.');
  }
});

</script>
