<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>חטיפי למידה · קורסים דיגיטליים לבית הספר היסודי</title>
<meta name="description" content="חטיפי למידה — קורסים דיגיטליים שלמים לבית הספר היסודי. תוכן, פעילויות ומשחקים מובנים. מוכרים בגפן. ללא הכנה למורה.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  :root{
    --bg:#F4F7FB; --bg-2:#EAF1F8; --surface:#FFFFFF; --surface-2:#F8FAFC;
    --navy:#0B2545; --navy-2:#13315C; --navy-3:#1E40AF;
    --blue:#2563EB; --blue-2:#3B82F6; --blue-light:#DBEAFE; --blue-faint:#EFF6FF;
    --cyan:#0891B2; --teal:#0D9488;
    --ink:#0F172A; --ink-2:#334155; --ink-soft:#475569; --ink-faint:#94A3B8;
    --line:#E2E8F0; --line-2:#CBD5E1;
    --wa:#16A34A; --wa-dark:#15803D;
    --pink:#E879A3;
    --radius:18px; --radius-lg:24px;
    --shadow:0 10px 30px -10px rgba(11,37,69,.18), 0 4px 10px -4px rgba(11,37,69,.08);
    --shadow-soft:0 6px 18px -6px rgba(11,37,69,.12);
    --shadow-strong:0 24px 60px -20px rgba(11,37,69,.28), 0 12px 30px -12px rgba(11,37,69,.18);
  }

  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  body{
    font-family:'Heebo',system-ui,sans-serif;
    background:var(--bg); color:var(--ink);
    line-height:1.65; font-weight:400;
    overflow-x:hidden;-webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block}
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
  a{color:inherit;text-decoration:none;cursor:pointer}

  .container{max-width:1240px;margin:0 auto;padding:0 24px;position:relative}

  /* ===================== TOPBAR ===================== */
  .topbar{
    position:sticky;top:0;z-index:50;
    background:rgba(244,247,251,.92);
    backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line);
  }
  .topbar-inner{
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 24px;max-width:1240px;margin:0 auto;gap:16px;
  }
  .brand{display:flex;align-items:center;gap:14px}
  .brand-logo{height:46px;width:auto;display:block}
  .brand-tagline{font-size:11px;color:var(--ink-soft);letter-spacing:1.5px;text-transform:uppercase;font-weight:500;line-height:1;margin-top:3px}

  .top-cta{display:flex;gap:10px;align-items:center}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:11px 20px;border-radius:10px;font-weight:600;font-size:14px;
    transition:transform .18s ease, box-shadow .18s ease, background .18s ease;
    white-space:nowrap;line-height:1;cursor:pointer;
    -webkit-tap-highlight-color:transparent;
  }
  .btn:hover{transform:translateY(-1px)}
  .btn:active{transform:translateY(0)}
  .btn-wa{background:var(--wa);color:#fff;box-shadow:0 6px 16px -6px rgba(22,163,74,.5)}
  .btn-wa:hover{background:var(--wa-dark);box-shadow:0 10px 22px -6px rgba(22,163,74,.6);color:#fff}
  .btn-primary{background:var(--blue);color:#fff;box-shadow:0 6px 16px -6px rgba(37,99,235,.5)}
  .btn-primary:hover{background:var(--navy-3);color:#fff;box-shadow:0 10px 22px -6px rgba(37,99,235,.6)}
  .btn-secondary{background:var(--navy);color:#fff}
  .btn-secondary:hover{background:#08182f;color:#fff}
  .btn-ghost{background:transparent;color:var(--navy);border:1.5px solid var(--line-2)}
  .btn-ghost:hover{background:var(--navy);color:#fff;border-color:var(--navy)}
  .btn svg{width:16px;height:16px;flex-shrink:0}

  /* ===================== HERO ===================== */
  .hero{padding:80px 0 70px;position:relative;overflow:hidden}
  .hero::before{
    content:'';position:absolute;top:-200px;left:-200px;width:600px;height:600px;
    background:radial-gradient(circle, rgba(37,99,235,.08) 0%, transparent 70%);
    border-radius:50%;pointer-events:none;
  }
  .hero::after{
    content:'';position:absolute;bottom:-300px;right:-200px;width:700px;height:700px;
    background:radial-gradient(circle, rgba(8,145,178,.07) 0%, transparent 70%);
    border-radius:50%;pointer-events:none;
  }
  .hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:center;position:relative;z-index:2}

  .badge{
    display:inline-flex;align-items:center;gap:8px;
    padding:7px 14px;background:var(--blue-faint);color:var(--navy-3);
    border:1px solid rgba(37,99,235,.15);
    border-radius:999px;font-size:12px;font-weight:600;letter-spacing:.5px;
    margin-bottom:24px;
  }
  .badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 4px rgba(37,99,235,.15)}

  .hero h1{
    font-weight:900;font-size:clamp(38px, 5.5vw, 64px);
    line-height:1.05;letter-spacing:-1.5px;
    color:var(--navy);margin-bottom:22px;
  }
  .hero h1 .accent{color:var(--blue);position:relative;display:inline-block}
  .hero h1 .accent::after{
    content:'';position:absolute;right:0;left:0;bottom:-4px;height:4px;
    background:linear-gradient(90deg, var(--blue) 0%, var(--cyan) 100%);
    border-radius:2px;
  }
  .hero-lede{
    font-size:clamp(16px, 1.3vw, 19px);color:var(--ink-soft);
    max-width:560px;margin-bottom:34px;line-height:1.75;
  }
  .hero-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:44px}
  .hero-ctas .btn{padding:14px 24px;font-size:15px}

  .hero-stats{
    display:grid;grid-template-columns:repeat(4, 1fr);gap:20px;
    padding:24px 28px;background:var(--surface);border-radius:var(--radius);
    box-shadow:var(--shadow-soft);border:1px solid var(--line);
  }
  .stat{display:flex;flex-direction:column;gap:4px}
  .stat-num{font-weight:800;font-size:28px;color:var(--navy);letter-spacing:-1px;line-height:1}
  .stat-label{font-size:12px;color:var(--ink-soft);font-weight:500}

  /* hero visual */
  .hero-visual{position:relative;height:480px;display:grid;place-items:center}
  .visual-stack{position:relative;width:100%;height:100%}
  .visual-card{
    position:absolute;background:var(--surface);border-radius:var(--radius);
    padding:20px;box-shadow:var(--shadow);border:1px solid var(--line);
    display:flex;flex-direction:column;gap:8px;
  }
  .visual-card-tag{font-size:11px;color:var(--blue);font-weight:700;letter-spacing:1px;text-transform:uppercase}
  .visual-card-title{font-weight:700;font-size:16px;color:var(--navy);letter-spacing:-.3px}
  .visual-card-meta{font-size:12px;color:var(--ink-soft)}
  .visual-card .swatch{
    width:100%;height:80px;border-radius:10px;margin-top:4px;
    position:relative;overflow:hidden;
  }
  .visual-card .swatch::before{
    content:'';position:absolute;inset:0;
    background-image:radial-gradient(circle at 30% 40%, rgba(255,255,255,.18) 0%, transparent 50%);
  }
  .vc-1{top:20px;right:0;width:240px;transform:rotate(-3deg)}
  .vc-1 .swatch{background:linear-gradient(135deg, #0D9488 0%, #06B6D4 100%)}
  .vc-2{top:90px;left:30px;width:230px;transform:rotate(2deg);z-index:2}
  .vc-2 .swatch{background:linear-gradient(135deg, #1E3A8A 0%, #3B82F6 100%)}
  .vc-3{bottom:80px;right:50px;width:250px;transform:rotate(-1deg);z-index:3}
  .vc-3 .swatch{background:linear-gradient(135deg, #0B2545 0%, #1E40AF 100%)}

  .gefen-circle{
    position:absolute;bottom:30px;left:0;
    width:130px;height:130px;border-radius:50%;
    background:var(--surface);box-shadow:var(--shadow);
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
    border:1px solid var(--line);text-align:center;z-index:4;
  }
  .gefen-circle .gefen-label{font-size:10px;color:var(--ink-soft);letter-spacing:1.5px;text-transform:uppercase;font-weight:600}
  .gefen-circle .gefen-name{font-weight:800;font-size:22px;color:var(--navy);letter-spacing:-.5px;line-height:1}
  .gefen-circle .gefen-mark{
    width:30px;height:30px;border-radius:50%;background:var(--blue-faint);
    color:var(--blue);display:grid;place-items:center;margin-bottom:4px;
  }
  .gefen-circle .gefen-mark svg{width:16px;height:16px}

  /* ===================== SECTIONS ===================== */
  .section{padding:80px 0;position:relative}
  .section-head{margin-bottom:50px;text-align:center;max-width:720px;margin-left:auto;margin-right:auto}
  .section-eyebrow{
    display:inline-block;font-size:12px;letter-spacing:2px;text-transform:uppercase;
    color:var(--blue);font-weight:700;margin-bottom:14px;
  }
  .section h2{
    font-weight:800;font-size:clamp(28px, 3.8vw, 42px);line-height:1.15;
    color:var(--navy);letter-spacing:-.8px;margin-bottom:16px;
  }
  .section-lede{font-size:16px;color:var(--ink-soft);line-height:1.75;max-width:640px;margin:0 auto}

  /* ===================== BENEFITS — new card style ===================== */
  .benefits{background:linear-gradient(180deg, var(--bg) 0%, var(--surface) 100%)}
  .benefits-grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:24px}
  .benefit-card{
    background:var(--surface);border-radius:var(--radius);
    padding:36px 28px 0;
    box-shadow:var(--shadow-soft);border:1px solid var(--line);
    text-align:center;position:relative;overflow:hidden;
    transition:transform .25s ease, box-shadow .25s ease;
    display:flex;flex-direction:column;
  }
  .benefit-card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
  .benefit-icon{
    width:64px;height:64px;border-radius:16px;
    background:var(--blue-faint);color:var(--blue);
    display:grid;place-items:center;margin:0 auto 20px;
  }
  .benefit-icon svg{width:30px;height:30px;stroke-width:1.8}
  .benefit-card h3{
    font-weight:700;font-size:19px;color:var(--navy);
    margin-bottom:10px;letter-spacing:-.3px;
  }
  .benefit-card p{color:var(--ink-soft);font-size:14.5px;line-height:1.7;flex:1}
  .benefit-accent{height:5px;margin-top:28px;background:var(--blue)}
  .ba-1 .benefit-accent{background:linear-gradient(90deg, var(--blue) 0%, var(--cyan) 100%)}
  .ba-2 .benefit-accent{background:linear-gradient(90deg, var(--navy-3) 0%, var(--blue-2) 100%)}
  .ba-3 .benefit-accent{background:linear-gradient(90deg, var(--cyan) 0%, var(--teal) 100%)}
  .ba-4 .benefit-accent{background:linear-gradient(90deg, var(--navy) 0%, var(--navy-3) 100%)}
  .ba-5 .benefit-accent{background:linear-gradient(90deg, var(--blue-2) 0%, var(--cyan) 100%)}
  .ba-6 .benefit-accent{background:linear-gradient(90deg, var(--teal) 0%, var(--blue) 100%)}

  /* ===================== COURSES — click-to-flip, gentle hover ===================== */
  .courses-section{background:var(--bg)}
  .courses-grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:16px}

  .card{
    perspective:1400px;height:500px;cursor:pointer;
    transition:transform .25s ease;
    box-sizing:border-box;
    width:100%;display:block;
  }
  /* gentle hover hint — slight lift only, no flip on hover */
  .card:hover{transform:translateY(-4px)}
  .card:hover .card-front{box-shadow:var(--shadow-strong)}
  .card:hover .flip-indicator{background:rgba(255,255,255,.95);color:var(--blue)}

  .card-inner{
    position:relative;width:100%;height:100%;
    transition:transform .65s cubic-bezier(.4,.05,.2,1);
    transform-style:preserve-3d;
  }
  .card.is-flipped .card-inner{transform:rotateY(180deg)}
  .card-face{
    position:absolute;inset:0;
    backface-visibility:hidden;-webkit-backface-visibility:hidden;
    border-radius:var(--radius-lg);overflow:hidden;
    box-shadow:var(--shadow);
  }
  /* Default: front is interactive, back is not */
  .card .card-front{pointer-events:auto}
  .card .card-back{pointer-events:none}
  /* When flipped: back becomes interactive, front stops intercepting clicks */
  .card.is-flipped .card-front{pointer-events:none}
  .card.is-flipped .card-back{pointer-events:auto}

  .card-front{
    display:flex;flex-direction:column;
    padding:0;color:#fff;background:var(--navy);
    transition:box-shadow .25s ease;
    overflow:hidden;
  }
  .card-photo{
    height:62%;width:100%;
    background:linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 50%, var(--navy-3) 100%);
    background-size:cover;background-position:center;
    position:relative;flex-shrink:0;
  }
  /* gentle fade at bottom of photo into the text area */
  .card-photo::after{
    content:'';position:absolute;left:0;right:0;bottom:-1px;height:48px;
    background:linear-gradient(180deg, rgba(11,37,69,0) 0%, var(--navy) 100%);
    pointer-events:none;
  }
  .card-shade{display:none}
  .card-text-area{
    flex:1;padding:20px 22px 22px;
    display:flex;flex-direction:column;justify-content:flex-end;
    background:var(--navy);
    position:relative;
  }
  .card-photo .grade-tag{
    position:absolute;top:18px;right:18px;z-index:3;
  }
  .card-front > .flip-indicator{z-index:4}
  .card-front > *:not(.card-photo):not(.card-shade){position:relative;z-index:2}

  .flip-indicator{
    position:absolute;top:-22px;left:18px;
    width:44px;height:44px;border-radius:50%;
    background:var(--surface);color:var(--navy);
    border:3px solid var(--navy);
    display:grid;place-items:center;
    transition:background .25s ease, color .25s ease, transform .25s ease;
    z-index:4;box-shadow:0 6px 16px -4px rgba(0,0,0,.4);
  }
  .flip-indicator svg{width:18px;height:18px;stroke-width:2}
  .card:hover .flip-indicator{
    background:var(--blue);color:#fff;
    transform:rotate(60deg);
  }

  .grade-tag{
    display:inline-flex;align-self:flex-start;align-items:center;gap:6px;
    background:rgba(255,255,255,.95);color:var(--navy);
    padding:6px 14px;border-radius:999px;font-size:12px;font-weight:700;
  }
  .grade-tag::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--blue)}

  .card-icon-wrap{
    width:64px;height:64px;border-radius:16px;
    background:rgba(255,255,255,.12);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
    border:1px solid rgba(255,255,255,.18);
    display:grid;place-items:center;margin-bottom:14px;
  }
  .card-icon-wrap svg{width:32px;height:32px;color:#fff;stroke-width:1.7}

  .card-front-bottom{display:flex;flex-direction:column;gap:6px}
  .card-title{
    font-weight:800;font-size:22px;line-height:1.2;letter-spacing:-.3px;color:#fff;
  }
  .card-subtitle{
    font-size:13px;font-weight:400;color:rgba(255,255,255,.8);line-height:1.55;
  }
  .new-badge{
    position:absolute;top:20px;right:20px;z-index:3;
    background:#EF4444;color:#fff;
    font-size:10px;font-weight:800;letter-spacing:1px;
    padding:4px 10px;border-radius:6px;
    box-shadow:0 4px 10px -2px rgba(239,68,68,.5);
  }

  .card-back{
    transform:rotateY(180deg);background:var(--surface);
    padding:24px 22px;display:flex;flex-direction:column;
    border:1px solid var(--line);
  }
  .card-back-tag{
    display:inline-flex;align-self:flex-start;align-items:center;gap:6px;
    font-size:11px;letter-spacing:1.5px;text-transform:uppercase;
    color:var(--blue);font-weight:700;margin-bottom:10px;
  }
  .card-back-title{
    font-weight:800;font-size:18px;line-height:1.2;color:var(--navy);
    margin-bottom:8px;letter-spacing:-.3px;
  }
  .card-back-grade{
    font-size:11px;color:var(--ink-soft);font-weight:600;
    margin-bottom:12px;padding-bottom:12px;
    border-bottom:1px solid var(--line);letter-spacing:.4px;
  }
  .card-back-body{font-size:13px;line-height:1.6;color:var(--ink-soft);flex:1;overflow:hidden}
  .card-back-body p{margin-bottom:6px}
  .card-back-body strong{color:var(--ink);font-weight:600}
  .card-back-cta{margin-top:12px;display:flex;gap:8px}
  .card-back-btn{
    flex:1;display:inline-flex;align-items:center;justify-content:center;gap:6px;
    padding:11px 14px;background:var(--navy);color:#fff;
    border-radius:10px;font-size:13px;font-weight:600;
    transition:background .18s ease;cursor:pointer;
  }
  .card-back-btn:hover{background:var(--blue)}
  .card-back-btn svg{width:13px;height:13px}
  .flip-back{
    width:42px;flex:0 0 42px;display:inline-flex;align-items:center;justify-content:center;
    background:var(--surface-2);color:var(--ink-2);
    border-radius:10px;font-size:13px;font-weight:600;
    transition:background .18s ease;cursor:pointer;
  }
  .flip-back:hover{background:var(--line)}
  .flip-back svg{width:16px;height:16px}

  /* ===================== QUOTE BLOCK ===================== */
  .quote-block{
    margin:70px auto 0;max-width:920px;text-align:center;
    padding:48px 40px;border-radius:var(--radius-lg);
    background:linear-gradient(135deg, var(--navy) 0%, var(--navy-3) 100%);
    color:#fff;position:relative;overflow:hidden;
  }
  .quote-block::before{
    content:'';position:absolute;top:-100px;left:-50px;width:300px;height:300px;
    background:radial-gradient(circle, rgba(255,255,255,.08) 0%, transparent 60%);
    border-radius:50%;
  }
  .quote-block p{
    font-weight:500;font-size:clamp(20px, 2.2vw, 26px);line-height:1.5;
    position:relative;z-index:2;
  }
  .quote-block .attribution{
    margin-top:18px;font-size:12px;letter-spacing:2px;text-transform:uppercase;
    color:#A4C6FB;font-weight:600;position:relative;z-index:2;
  }

  /* ===================== CONTACT ===================== */
  .contact{
    background:linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
    color:#fff;padding:80px 0;position:relative;overflow:hidden;
  }
  .contact::before{
    content:'';position:absolute;top:-150px;left:-100px;width:500px;height:500px;
    background:radial-gradient(circle, rgba(37,99,235,.2) 0%, transparent 60%);
    border-radius:50%;
  }
  .contact::after{
    content:'';position:absolute;bottom:-200px;right:-100px;width:600px;height:600px;
    background:radial-gradient(circle, rgba(8,145,178,.15) 0%, transparent 60%);
    border-radius:50%;
  }
  .contact-inner{position:relative;z-index:2;text-align:center;max-width:720px;margin:0 auto}
  .contact .section-eyebrow{color:#7AB3FB}
  .contact h2{color:#fff;margin-bottom:18px}
  .contact p.lead{font-size:17px;color:rgba(255,255,255,.85);margin-bottom:36px;line-height:1.7}
  .contact-ctas{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:44px}
  .contact-ctas .btn{padding:15px 28px;font-size:15px}
  .contact-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:560px;margin:0 auto}
  .contact-card{
    background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);
    padding:22px;border-radius:14px;text-align:right;
    backdrop-filter:blur(8px);transition:background .2s, transform .2s;cursor:pointer;
  }
  .contact-card:hover{background:rgba(255,255,255,.12);transform:translateY(-2px)}
  .contact-card-label{font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:#7AB3FB;margin-bottom:8px;font-weight:600}
  .contact-card-val{font-weight:700;font-size:18px;color:#fff;letter-spacing:.3px;direction:ltr;text-align:right;word-break:break-all}

  footer{padding:32px 0;text-align:center;font-size:13px;color:var(--ink-soft);background:var(--bg-2);border-top:1px solid var(--line)}
  footer strong{color:var(--ink);font-weight:700}

  /* ===================== MODAL ===================== */
  .modal-backdrop{
    position:fixed;inset:0;z-index:100;
    background:rgba(11,37,69,.6);backdrop-filter:blur(10px);
    display:none;align-items:center;justify-content:center;padding:20px;
    opacity:0;transition:opacity .25s ease;
  }
  .modal-backdrop.is-open{display:flex;opacity:1}
  .modal{
    background:var(--surface);border-radius:var(--radius-lg);
    width:100%;max-width:1080px;height:88vh;max-height:900px;
    display:flex;flex-direction:column;overflow:hidden;
    box-shadow:0 60px 120px -30px rgba(0,0,0,.5);
    transform:translateY(20px);transition:transform .3s ease;
  }
  .modal-backdrop.is-open .modal{transform:translateY(0)}
  .modal-header{
    display:flex;align-items:center;justify-content:space-between;
    padding:18px 24px;border-bottom:1px solid var(--line);
    background:var(--surface);flex-shrink:0;gap:12px;
  }
  .modal-title{font-weight:800;font-size:20px;color:var(--navy);letter-spacing:-.3px}
