  .modal-fallback.show{opacity:1;pointer-events:auto}
  .modal-fallback h4{font-size:20px;color:var(--navy);font-weight:700}
  .modal-fallback p{color:var(--ink-soft);max-width:400px;font-size:14px}

  .rich-content{padding:36px 40px;color:var(--ink);max-width:920px;margin:0 auto;line-height:1.75}
  .rich-content h3{font-weight:800;font-size:26px;color:var(--navy);margin:28px 0 12px;letter-spacing:-.4px}
  .rich-content h3:first-child{margin-top:0}
  .rich-content h4{font-weight:700;font-size:18px;color:var(--blue);margin:22px 0 10px}
  .rich-content p{margin-bottom:12px;color:var(--ink-soft);font-size:15px}
  .rich-content strong{color:var(--ink);font-weight:700}
  .rich-content ul{padding-right:20px;margin-bottom:14px}
  .rich-content li{margin-bottom:6px;color:var(--ink-soft);font-size:14.5px}
  .rich-content .grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin:14px 0}
  .pillar{padding:18px;background:var(--surface-2);border-radius:12px;border-right:3px solid var(--blue)}
  .pillar h5{font-weight:700;font-size:15px;color:var(--navy);margin-bottom:6px}
  .pillar p{font-size:13.5px;margin:0;color:var(--ink-soft);line-height:1.55}
  .pillar.pillar-1{border-right-color:var(--navy);background:#EFF6FF}
  .pillar.pillar-2{border-right-color:var(--blue);background:#E0F2FE}
  .pillar.pillar-3{border-right-color:var(--cyan);background:#ECFEFF}
  .pillar.pillar-4{border-right-color:var(--teal);background:#F0FDFA}

  .syllabus{margin-top:14px;background:var(--surface-2);border-radius:14px;overflow:hidden;border:1px solid var(--line)}
  .syllabus-row{display:grid;grid-template-columns:60px 1fr 1fr;gap:12px;padding:11px 18px;border-bottom:1px solid var(--line);font-size:13.5px;align-items:center}
  .syllabus-row:last-child{border-bottom:none}
  .syllabus-row.header{background:var(--navy);color:#fff;font-weight:700;font-size:12.5px;letter-spacing:.5px}
  .syllabus-row .num{font-weight:800;color:var(--blue)}
  .syllabus-row.header .num{color:#7AB3FB}
  /* When syllabus has only 2-column data (no "what we'll prepare"), collapse the empty 3rd col */
  .syllabus.compact .syllabus-row{grid-template-columns:60px 1fr}
  .syllabus.compact .syllabus-row > *:nth-child(3){display:none}

  .formula-box{
    text-align:center;padding:20px;
    background:linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%);
    color:#fff;border-radius:14px;font-size:17px;font-weight:600;margin:18px 0;
  }

  /* External link block — for courses with both rich content + external website */
  .external-link-block{
    margin-top:32px;padding:24px 26px;
    background:linear-gradient(135deg, var(--blue-faint) 0%, #E0F2FE 100%);
    border:1.5px solid rgba(37,99,235,.15);border-radius:16px;
    display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;
  }
  .external-link-text{flex:1;min-width:200px}
  .external-link-text strong{
    display:block;font-size:17px;color:var(--navy);font-weight:800;margin-bottom:4px;
  }
  .external-link-text p{
    font-size:14px;color:var(--ink-soft);margin:0;line-height:1.5;
  }
  .external-link-btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:13px 22px;border-radius:11px;
    background:var(--blue);color:#fff;font-weight:700;font-size:14px;
    transition:transform .18s, box-shadow .18s, background .18s;
    box-shadow:0 6px 16px -6px rgba(37,99,235,.5);
    white-space:nowrap;flex-shrink:0;
  }
  .external-link-btn:hover{
    transform:translateY(-1px);background:var(--navy-3);color:#fff;
    box-shadow:0 10px 22px -6px rgba(37,99,235,.6);
  }
  .external-link-btn svg{width:14px;height:14px}

  /* Course feature lists in modals (highlight boxes) */
  .feature-list{
    margin:14px 0;padding:18px 22px;
    background:var(--surface-2);border-right:3px solid var(--blue);border-radius:12px;
  }
  .feature-list ul{padding-right:18px;margin:0}
  .feature-list li{
    margin-bottom:8px;color:var(--ink);font-size:14.5px;line-height:1.6;
    list-style:none;position:relative;padding-right:22px;
  }
  .feature-list li::before{
    content:'';position:absolute;right:0;top:8px;
    width:8px;height:8px;border-radius:50%;background:var(--blue);
  }
  .feature-list li strong{color:var(--navy)}

  /* Tag chips for course topics */
  .topic-chips{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}
  .topic-chip{
    display:inline-flex;align-items:center;gap:6px;
    padding:7px 14px;border-radius:999px;
    background:var(--blue-faint);color:var(--navy);
    font-size:13px;font-weight:600;
    border:1px solid rgba(37,99,235,.15);
  }
  .topic-chip .num{
    width:20px;height:20px;border-radius:50%;background:var(--blue);color:#fff;
    display:grid;place-items:center;font-size:11px;font-weight:800;flex-shrink:0;
  }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 1024px){
    .hero-grid{grid-template-columns:1fr;gap:50px}
    .hero-visual{height:400px;max-width:520px;margin:0 auto}
    .courses-grid{grid-template-columns:repeat(2,1fr)}
    .benefits-grid{grid-template-columns:repeat(2,1fr)}
    .hero-stats{grid-template-columns:repeat(4,1fr);padding:20px}
    .stat-num{font-size:22px}
  }
  @media (max-width: 720px){
    .topbar-inner{padding:12px 18px}
    .brand-logo{height:38px}
    .brand-tagline{display:none}
    .top-cta .btn:not(.btn-wa){display:none}
    .hero{padding:50px 0 40px}
    .section{padding:60px 0}
    .courses-grid{grid-template-columns:1fr;gap:20px}
    .benefits-grid{grid-template-columns:1fr;gap:18px}
    .hero-stats{grid-template-columns:repeat(2,1fr);gap:14px}
